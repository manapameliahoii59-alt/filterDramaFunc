# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and test artifacts
.pytest_cache/
*.tmp

# Environment variables & API Keys (DO NOT COMMIT)
.env
auth.json
*.har
*dump*.json
scratch/
*.db
auth_pool/

# OS files
Thumbs.db
Desktop.ini

# Desktop app token cache
.iocpx_session.json

# Runtime data caches (generated by scripts)
novel_trends/data/*.json
data/daily_fetch/*.json
data/daily_fetch/*.csv

# Desktop app build artifacts
desktop_app/**/__pycache__/
desktop_app/**/*.py[cod]
